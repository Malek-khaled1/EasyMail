<Window x:Class="MalikClient.Views.LoginWindow"
        x:Name="SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="EasyMail Login" Height="525" Width="800">

    <Grid Background="AliceBlue">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITEL -->
        <TextBlock Grid.Row="0"
                   Text="EasyMail"
                   FontSize="48"
                   Foreground="#222"
                   FontWeight="Bold"
                   FontFamily="Arial Rounded MT Bold"
                   HorizontalAlignment="Center"
                   Margin="0 20 0 20"/>

        <!-- CHOOSE EXISTING ACCOUNT -->
        <TextBlock Grid.Row="1"
                   Text="Choose existing account"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#444"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 10">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasExistingUsers}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- LISTE MED BRUGERE -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Height="260"
                      Margin="0 0 0 20">

            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Button Command="{Binding DataContext.SelectUserCommand, ElementName=SignInWindow}"
                                CommandParameter="{Binding}"
                                Background="White"
                                BorderBrush="#E8E8E8"
                                BorderThickness="1"
                                Padding="6"
                                Margin="0 0 0 10"
                                Cursor="Hand"
                                HorizontalAlignment="Center"
                                Width="300">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="card"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="6">

                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10"
                                                              ShadowDepth="2"
                                                              Opacity="0.15"/>
                                        </Border.Effect>

                                        <DockPanel LastChildFill="True">

                                            <!-- Profilbillede -->
                                            <Grid Width="36" Height="36"
                                                  DockPanel.Dock="Left"
                                                  Margin="0 0 10 0">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                <Grid.Clip>
                                                    <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/>
                                                </Grid.Clip>
                                            </Grid>

                                            <!-- Navn + email -->
                                            <StackPanel VerticalAlignment="Center"
                                                        DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="16"
                                                           Foreground="#222"/>
                                                <TextBlock Text="{Binding Email}"
                                                           FontSize="13"
                                                           Foreground="#666"/>
                                            </StackPanel>

                                            <!-- Delete-knap, kun synlig når man hover over selve krydset -->
                                            <Button x:Name="deleteBtn"
                                                    Command="{Binding DataContext.DeleteUserCommand, ElementName=SignInWindow}"
                                                    CommandParameter="{Binding}"
                                                    Width="20"
                                                    Height="20"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Focusable="False"
                                                    Cursor="Hand"
                                                    Margin="0 0 0 0"
                                                    HorizontalAlignment="Right"
                                                    DockPanel.Dock="Right"
                                                    Opacity="0">            

                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Width="28" Height="28"
                                                                Background="Transparent">
                                                            <Path Data="M4,4 L16,16 M16,4 L4,16"
                                                                  Stroke="red"
                                                                  StrokeThickness="2"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>

                                            </Button>

                                        </DockPanel>
                                    </Border>

                                    <!-- Triggers -->
                                    <ControlTemplate.Triggers>

                                        <!-- Hover på delete-knappen → vis knappen -->
                                        <Trigger SourceName="deleteBtn"
                                                 Property="IsMouseOver"
                                                 Value="True">
                                            <Setter TargetName="deleteBtn" Property="Opacity" Value="1"/>
                                        </Trigger>

                                        <!-- Hover på card → baggrundsfarve -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="#F4F4F4"/>
                                        </Trigger>

                                        <!-- Tryk på card -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="card" Property="Background" Value="#E0E0E0"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

        <!-- GOOGLE LOGIN KNAP + STATUS -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center">

            <Button Width="240" Height="48"
                    Command="{Binding GoogleLoginCommand}"
                    Background="White"
                    BorderBrush="#E8E8E8"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0 0 0 15">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Image Source="/Assets/google.png"
                                       Width="20" Height="20"
                                       Margin="0 0 10 0"/>
                                <TextBlock Text="Sign in with Google"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           Foreground="#333"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F4F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#383838"
                       HorizontalAlignment="Center"
                       Margin="0 5 0 15"
                       FontSize="15"/>
        </StackPanel>

    </Grid>
</Window>

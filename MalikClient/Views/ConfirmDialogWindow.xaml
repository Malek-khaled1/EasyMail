<Window x:Class="MalikClient.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="White"
        MinWidth="340">

    <StackPanel Margin="20" Width="360">

        <!-- CONFIRM TEXT -->
        <TextBlock 
                   FontSize="16"
                   Foreground="#222"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0 0 0 20">

            <!-- Line 1 (REMOVE is bold automatically due to font) -->
            <Run Text="Remove" FontWeight="Bold"/>
            <Run Text="this account?"/>
            <LineBreak/>
            <LineBreak/>

            <!-- Final line -->
            <Run Text="This will delete all data for this user from EasyMail"
                 FontWeight="Normal"
                 Foreground="#555"/>
        </TextBlock>


        <!-- BUTTON ROW -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <!-- CANCEL BUTTON -->
            <Button Content="{Binding CancelText}"
                    Width="80"
                    Height="30"
                    Margin="0 0 10 0"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}">
                <Button.Style>
                    <Style TargetType="Button">

                        <!-- Default -->
                        <Setter Property="Background" Value="#FAFAFA"/>
                        <Setter Property="BorderBrush" Value="#C8C8C8"/>
                        <Setter Property="BorderThickness" Value="1.3"/>
                        <Setter Property="Foreground" Value="#333"/>

                        <!-- Template -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="6 4">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="Arial Rounded MT"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <!-- Hover -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="BorderBrush" Value="#A0A0A0"/>
                            </Trigger>
                        </Style.Triggers>

                    </Style>
                </Button.Style>
            </Button>


            <!-- REMOVE BUTTON -->
            <Button Content="{Binding ConfirmText}"
                    Width="80"
                    Height="30"
                    Cursor="Hand"
                    Command="{Binding ConfirmCommand}">
                <Button.Style>
                    <Style TargetType="Button">

                        <!-- Default -->
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="BorderBrush" Value="#D32F2F"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Foreground" Value="White"/>

                        <!-- Template -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="8"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="6 4">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   FontFamily="Arial Rounded MT Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                        <!-- Hover -->
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </Style.Triggers>

                    </Style>
                </Button.Style>
            </Button>

        </StackPanel>

    </StackPanel>
</Window>

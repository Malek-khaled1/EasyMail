<UserControl x:Class="MalikClient.Views.ComposePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MalikClient.ViewModels"
             mc:Ignorable="d">

    <!-- Ingen margin her: den kommer fra MainWindow -->
    <Border Style="{StaticResource CardBorder}"
            Margin="0">
        <Grid Grid.IsSharedSizeScope="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- To -->
                <RowDefinition Height="Auto"/>
                <!-- Cc -->
                <RowDefinition Height="Auto"/>
                <!-- Bcc -->
                <RowDefinition Height="Auto"/>
                <!-- Subject -->
                <RowDefinition Height="*"/>
                <!-- Body -->
                <RowDefinition Height="Auto"/>
                <!-- Status -->
            </Grid.RowDefinitions>

            <!-- HEADER BAR -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Send"
                        Command="{Binding SendEmailCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Padding="22,6"
                        Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="From:"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="15"
                               Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentUser.Email}"
                               Foreground="#111827"
                               FontSize="15"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="✕"
                        Command="{Binding CloseComposeCommand}"
                        Style="{StaticResource IconButton}"/>
            </Grid>

            <!-- TO-LINJE -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ComposeLabel"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="To"
                           Style="{StaticResource FieldLabel}"/>

                <Border Grid.Column="1"
                        Style="{StaticResource ToBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CHIP-LISTE -->
                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding ToRecipients}"
                                      Focusable="False"
                                      IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecipientChip}">
                                    <Border Style="{StaticResource RecipientChipBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Address}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="150"/>

                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveRecipientCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Width="20"
                                                    Height="20"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- TO-INPUT -->
                        <Grid Grid.Row="1">
                            <TextBox x:Name="ToInputBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding ToInput, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       Text="Add recipients"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ToInput}" Value=""/>
                                                    <Condition Binding="{Binding ToRecipients.Count}" Value="0"/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ToInputBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Cc / Bcc links -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="Cc"
                            Command="{Binding ToggleCcCommand}"
                            Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCcVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Bcc"
                            Command="{Binding ToggleBccCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBccVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- CC-LINJE -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,2"
                  Visibility="{Binding IsCcVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ComposeLabel"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Cc"
                           Style="{StaticResource FieldLabel}"/>

                <Border Grid.Column="1"
                        Style="{StaticResource CcBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding CcRecipients}"
                                      Focusable="False"
                                      IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecipientChip}">
                                    <Border Style="{StaticResource RecipientChipBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Address}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="150"/>

                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveRecipientCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Width="20"
                                                    Height="20"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="1">
                            <TextBox x:Name="CcInputBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CcInput, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       Text="Add Cc recipients"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CcInput}" Value=""/>
                                                    <Condition Binding="{Binding CcRecipients.Count}" Value="0"/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=CcInputBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- BCC-LINJE -->
            <Grid Grid.Row="3"
                  Margin="0,0,0,2"
                  Visibility="{Binding IsBccVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ComposeLabel"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Bcc"
                           Style="{StaticResource FieldLabel}"/>

                <Border Grid.Column="1"
                        Style="{StaticResource BccBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding BccRecipients}"
                                      Focusable="False"
                                      IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecipientChip}">
                                    <Border Style="{StaticResource RecipientChipBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Address}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="150"/>

                                            <Button Grid.Column="1"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveRecipientCommand,
                                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Width="20"
                                                    Height="20"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Grid.Row="1">
                            <TextBox x:Name="BccInputBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     MinHeight="28"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding BccInput, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PlaceholderTextBrush}"
                                       Text="Add Bcc recipients"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding BccInput}" Value=""/>
                                                    <Condition Binding="{Binding BccRecipients.Count}" Value="0"/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BccInputBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- SUBJECT -->
            <Grid Grid.Row="4"
                  Margin="0,12,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="SubjectTextBox"
                             Text="{Binding Subject}"
                             Style="{StaticResource ComposeLineTextBox}"
                             Height="32"
                             Padding="4,6"/>

                    <TextBlock Text="Add a subject"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PlaceholderTextBrush}"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Text, ElementName=SubjectTextBox}" Value=""/>
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SubjectTextBox}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- BODY -->
            <TextBox Grid.Row="5"
                     Text="{Binding Body}"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Padding="10"
                     BorderThickness="0"
                     BorderBrush="Transparent"
                     Background="White"
                     Margin="0,8,0,8"/>

            <!-- STATUS -->
            <TextBlock Grid.Row="6"
                       Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
